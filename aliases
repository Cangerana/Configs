#/bin/bash
# Alias

###############################################################################
##################################### BASH ####################################
###############################################################################

alias cd..='cd ..'
alias ..='cd ..'
alias cddow='cd ${HOME}/Downloads'
alias cddoc='cd ${HOME}/Documents'
alias ll='ls -alF'
alias delete='rm -rf'
alias cdl='_(){ cd $1; ll; };_'

alias reset='exec $SHELL'

alias hg='history | grep'

alias fh='free -h'

###############################################################################
#################################### System ###################################
###############################################################################

alias update='sudo apt update && sudo apt upgrade && sudo apt clean && sudo apt autoclean && sudo apt autoremove'
alias download='sudo apt install'
alias search='sudo apt search'

alias restart='sudo systemctl restart NetworkManager.service'

###############################################################################
#################################### CLI ###################################
###############################################################################

alias tmux="TERM=tmux tmux"
alias t='tmux a -t .'
alias tw='${HOME}/local/bin/work_tmux_start.sh'

alias nc='cd ~/.config/nvim && n'
alias vim="nvim"
alias n='nvim'
alias n.='nvim .'

alias gs='git status'
alias ga='git add'
alias gd='git diff'
alias gl='git log'
alias gc='git checkout'
alias gcm='git commit -m'
alias glo='git log --oneline'
alias giupm='git checkout main && git fetch --all && git pull && git status'
alias giupd='git checkout develop && git fetch --all && git pull && git status'
alias gat='git_authentication'

###############################################################################
################################### Projects ##################################
###############################################################################

alias projects='cd ${PROJECTS_DIRECTORY}'
alias snt='cd ${PROJECTS_DIRECTORY}/simple_notification'
alias zenrunner='cd ${PROJECTS_DIRECTORY}/zenrunner_api'
alias utility_belt='cd ${PROJECTS_DIRECTORY}/../tools/utility_belt'
alias mainp='cd ${MAIN_PROJECT}'
alias mainn='cd ${OBSIDIAN} && nvim'

###############################################################################
##################################### RoR #####################################
###############################################################################

alias bi='rm -rf Gemfile.lock && bundle install'
alias bu='bundle update'
alias rs='rails server webrick'
